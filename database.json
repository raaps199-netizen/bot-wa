const fs = require('fs');
const path = require('path');

global.saveDatabase = function() {
  // Simpan database utama ke folder root (tetap di-handle railway volume jika ada)
  const dbPath = path.join(__dirname, 'database.json');
  
  // Simpan backup aman ke folder /tmp/ di server (tidak akan merah/ter-track di github)
  const backupPath = path.join('/tmp', 'backup_db.json');

  try {
    const dataString = JSON.stringify(global.db, null, 2);
    
    // Simpan database utama
    fs.writeFileSync(dbPath, dataString);
    
    // Simpan backup di folder /tmp server
    fs.writeFileSync(backupPath, dataString);
  } catch (err) {
    console.error('Gagal menyimpan database:', err);
  }
};
